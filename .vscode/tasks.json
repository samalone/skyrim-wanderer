{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Professional\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 && set VCPKG_ROOT=C:\\vcpkg && cmake --preset default"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Professional\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 && set VCPKG_ROOT=C:\\vcpkg && cmake --build build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "dependsOn": "Configure"
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "copy",
            "args": [
                "/Y",
                "build\\Wanderer.dll",
                "G:\\Steam\\steamapps\\common\\Skyrim Special Edition\\Data\\SKSE\\Plugins\\Wanderer.dll"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build",
            "problemMatcher": []
        },
        {
            "label": "Build & Install",
            "dependsOn": "Install",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
