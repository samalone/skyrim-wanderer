{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "${workspaceFolder}/build.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Install",
            "type": "process",
            "command": "${workspaceFolder}/install.bat",
            "dependsOn": "Build",
            "problemMatcher": []
        },
        {
            "label": "Build & Install",
            "dependsOn": "Install",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
