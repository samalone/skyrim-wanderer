{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "Wanderer",
  "displayName": "Wanderer",
  "minMcmVersion": 13,
  "pluginRequirements": ["Wanderer.esp"],
  "content": [
    {
      "text": "General",
      "type": "header"
    },
    {
      "id": "bModEnabled:General",
      "text": "Enable Wanderer",
      "type": "toggle",
      "help": "When enabled, Wanderer automatically tracks the nearest quests as you explore.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "type": "empty"
    },
    {
      "text": "Tracking",
      "type": "header"
    },
    {
      "id": "iMaxActiveQuests:Tracking",
      "text": "Max Active Quests",
      "type": "slider",
      "help": "Maximum number of quests Wanderer will track simultaneously.",
      "valueOptions": {
        "min": 1,
        "max": 10,
        "step": 1,
        "formatString": "{0}",
        "sourceType": "ModSettingInt"
      }
    },
    {
      "id": "iMaxActiveMarkers:Tracking",
      "text": "Max Active Markers",
      "type": "slider",
      "help": "Maximum total number of quest markers across all tracked quests.",
      "valueOptions": {
        "min": 1,
        "max": 20,
        "step": 1,
        "formatString": "{0}",
        "sourceType": "ModSettingInt"
      }
    },
    {
      "id": "fMaxMarkerDistance:Tracking",
      "text": "Max Marker Distance",
      "type": "slider",
      "help": "Quests with no markers closer than this distance (in cells) will not be tracked. One cell is roughly the width of a town square.",
      "valueOptions": {
        "min": 1.0,
        "max": 50.0,
        "step": 1.0,
        "formatString": "{0} cells",
        "sourceType": "ModSettingFloat"
      }
    },
    {
      "id": "fRecheckDistance:Tracking",
      "text": "Recheck Distance",
      "type": "slider",
      "help": "How far you must travel (in cells) before Wanderer re-evaluates which quests to track. Lower values are more responsive but do more work.",
      "valueOptions": {
        "min": 0.25,
        "max": 5.0,
        "step": 0.25,
        "formatString": "{2} cells",
        "sourceType": "ModSettingFloat"
      }
    },
    {
      "type": "empty"
    },
    {
      "text": "Overrides",
      "type": "header"
    },
    {
      "text": "To pin a quest (always track), activate it in your journal. To hide a quest (never auto-track), deactivate it. Toggle again to undo.",
      "type": "text"
    },
    {
      "id": "bResetOverrides:Overrides",
      "text": "Reset All Overrides",
      "type": "toggle",
      "help": "Enable this toggle to clear all pinned/hidden overrides. It will automatically turn itself off after clearing.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "WandererMCM",
        "function": "ClearOverrides"
      }
    }
  ]
}
